generator client {
    provider   = "prisma-client-js"
    engineType = "client"
}

datasource db {
    provider = "postgresql"
}

enum PeriodType {
    MONTH
    WEEK
}

enum PlanStatus {
    ACTIVE
    COMPLETED
}

enum ChallengeCategory {
    NATURE
    WALKING
    EXPLORATION
    PHOTOGRAPHY
    RUNNING
    CULTURE
    WILDLIFE
    FOOD
    WELLNESS
    OTHER
}

enum Difficulty {
    EASY
    MODERATE
    ADVENTUROUS
}

model Plan {
    id          String      @id @default(cuid())
    periodType  PeriodType  @default(MONTH)
    month       Int
    year        Int
    season      String
    title       String
    location    String
    preferences Json
    target      Int
    status      PlanStatus  @default(ACTIVE)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    completedAt DateTime?
    challenges  Challenge[]
    reflection  Reflection?

    @@index([status, year, month])
}

model Challenge {
    id               String            @id @default(cuid())
    planId           String
    title            String
    description      String
    category         ChallengeCategory
    estimatedMinutes Int
    difficulty       Difficulty
    weekNumber       Int
    completed        Boolean           @default(false)
    completedAt      DateTime?
    note             String?
    createdAt        DateTime          @default(now())
    plan             Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)

    @@index([planId, weekNumber])
}

model Reflection {
    id        String   @id @default(cuid())
    planId    String   @unique
    content   String
    createdAt DateTime @default(now())
    plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}
